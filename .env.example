# Ambiente
NODE_ENV=production
PORT=3000

# Banco de dados (Railway preenche automaticamente via plugin MySQL)
DB_HOST=
DB_PORT=3306
DB_NAME=railway
DB_USER=root
DB_PASS=

# JWT
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria
JWT_EXPIRES_IN=7d

# CORS - coloque a URL do seu frontend (ex: https://weekly-reports.railway.app)
CORS_ORIGIN=*
