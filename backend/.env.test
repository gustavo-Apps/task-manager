# Variáveis de ambiente — copie este arquivo para .env e preencha

# Servidor
PORT=3000
NODE_ENV=development

# Banco de dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=weekly_reports_test
DB_USER=root
DB_PASS=

# JWT — use uma chave longa e aleatória em produção
# Gerar com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=1d5cdaad5b60ff6d8d78c838a9d672f4be75ae8839e31b287db103931e2c1870bb9508122ad4da2e38b3febdf639c884eead883c09f1670c82f3af030b81bcb3
JWT_EXPIRES_IN=7d

# Pasta onde os relatórios .md serão salvos (relativo à raiz do projeto)
REPORTS_DIR=reports/generated
