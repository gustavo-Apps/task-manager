# Variáveis de ambiente — copie este arquivo para .env e preencha
# Instruções completas no README.md

# ─── Servidor ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Banco de dados MySQL / MariaDB ──────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=weekly_reports
DB_USER=root
DB_PASS=                      # deixe vazio se não tiver senha localmente

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Gerar chave segura:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=troque_por_uma_chave_longa_e_aleatoria
JWT_EXPIRES_IN=7d

# ─── Relatórios ──────────────────────────────────────────────────────────────
# Pasta onde os arquivos .md serão salvos (relativo à raiz do backend)
REPORTS_DIR=reports/generated
