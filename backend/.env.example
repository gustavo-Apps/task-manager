# Variáveis de ambiente — copie este arquivo para .env e preencha

# Servidor
PORT=3000
NODE_ENV=development

# Banco de dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=weekly_reports
DB_USER=root
DB_PASS=sua_senha_aqui

# JWT — use uma chave longa e aleatória em produção
# Gerar com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=troque_por_uma_chave_secreta_longa
JWT_EXPIRES_IN=7d

# Pasta onde os relatórios .md serão salvos (relativo à raiz do projeto)
REPORTS_DIR=reports/generated
